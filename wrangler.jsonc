{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ni-idea",
  "main": "party/server.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Main"]
    }
  ]
}
