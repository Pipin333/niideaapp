{
  "name": "ni-idea",
  "version": "1.0.0",
  "private": true,
  "description": "Consola social multijugador en tiempo real: Trivia Rush, Ese Eres Tu y Pinturillo sobre PartyServer (Cloudflare Durable Objects) y Astro.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "tsx scripts/prod-server.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.18",
    "partyserver": "^0.1.3",
    "partysocket": "^1.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.109.2"
  }
}
